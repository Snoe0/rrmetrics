# RR Metrics — self-hosted server configuration
# Copy to .env and adjust. Every variable is optional; sane defaults apply.

# Port the HTTP server listens on (default: 8459)
#PORT=8459

# Public base URL of the app. Used to build broker OAuth redirect URIs.
# (default: http://localhost:<PORT>)
#APP_URL=http://localhost:8459

# Directory for the SQLite database, uploaded screenshots, and the server
# secret key (default: ./data relative to the working directory)
#DATA_DIR=./data

# 64-character hex key (32 bytes) used to encrypt broker credentials at rest.
# If unset, the auto-generated key in data/secret.key is used.
# Generate one with: openssl rand -hex 32
#ENCRYPTION_KEY=

# ── Tradovate OAuth (optional — required only for Tradovate-compatible broker sync)
#TRADOVATE_CLIENT_ID=
#TRADOVATE_CLIENT_SECRET=

# ── Webull OpenAPI (optional — required only for Webull sync)
#WEBULL_APP_ID=
#WEBULL_APP_SECRET=
